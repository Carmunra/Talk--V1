# Server only. Store secrets in a secret manager; never prefix secrets with VITE_.
NODE_ENV=development
PORT=3000
# Use 1 only when the app port is isolated behind the sole trusted reverse proxy.
TRUST_PROXY_HOPS=0
APP_ORIGIN=http://localhost:3000
FIREBASE_PROJECT_ID=
FIRESTORE_DATABASE_ID=(default)
# Use workload identity / Application Default Credentials in production.
# GOOGLE_APPLICATION_CREDENTIALS=/path/outside/repository/service-account.json
LEGAL_NAME=
LEGAL_CNPJ=
PRIVACY_EMAIL=
SUPPORT_EMAIL=
SUPPORT_EMAIL_SECONDARY=
LEGAL_APPROVED=false
TERMS_VERSION=2026-10-12
MINIMUM_AGE=18
MINORS_ENABLED=false
MINORS_SAFEGUARDS_APPROVED=false
PAYMENTS_ENABLED=false
PAYMENTS_HOMOLOGATED=false
MP_ENVIRONMENT=sandbox
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_WEBHOOK_SECRET=
# 32 random bytes, base64 encoded. Back up securely.
TOKEN_ENCRYPTION_KEY=
# Legacy Sandbox API gate; SUBSCRIPTIONS_ENABLED also exposes the customer interface.
ASAAS_SANDBOX_ENABLED=false
ASAAS_SANDBOX_API_KEY=
ASAAS_SANDBOX_WEBHOOK_TOKEN=
ASAAS_SANDBOX_ACCOUNT_ID=
SUBSCRIPTIONS_ENABLED=false
ASAAS_ENVIRONMENT=sandbox
# Never enable live billing before external homologation and operator approvals.
ASAAS_PRODUCTION_APPROVED=false
SUBSCRIPTION_RULES_APPROVED=false
# Approved rule: 60_days_after_cancel. Live still requires an explicit selection.
# Legacy alternatives: keep_until_expiry OR block_booking.
SUBSCRIPTION_CANCEL_CREDITS=
# Live secrets: server only, in the hosting secret manager. Never use Sandbox keys here.
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASAAS_ACCOUNT_ID=
DAILY_API_KEY=
DAILY_DOMAIN=
VIDEO_PROVIDER=google_meet
# Public Firebase web configuration; separate staging and production.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
