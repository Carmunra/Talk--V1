{
  "name": "talke",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "test:e2e:server": "tsx tests/support/e2e-server.ts",
    "dev": "node --env-file-if-exists=.env --import tsx server.ts",
    "cypress:run": "cypress run --browser electron",
    "start": "node dist/server/index.js",
    "test": "tsx --test tests/unit/*.test.ts tests/integration/*.test.ts",
    "test:e2e": "firebase emulators:exec --project demo-talke --only auth \"start-server-and-test test:e2e:server http://127.0.0.1:3000/api/health cypress:run\"",
    "test:rules": "firebase emulators:exec --project demo-talke --only firestore \"tsx --test tests/rules/*.test.ts\"",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server/index.js && esbuild scripts/reconcile.ts scripts/set-admin.ts scripts/preflight.ts --bundle --platform=node --format=esm --packages=external --outdir=dist/scripts",
    "lint": "tsc --noEmit",
    "test:coverage": "c8 --all --include=src/server/** --check-coverage --lines=80 --branches=70 --functions=75 --reporter=text --reporter=lcov npm test",
    "verify:artifacts": "node scripts/verify-artifacts.mjs",
    "verify:lockfile": "node scripts/verify-lockfile.mjs",
    "payments:reconcile": "node --env-file-if-exists=.env dist/scripts/reconcile.js",
    "admin:permissions": "node --env-file-if-exists=.env dist/scripts/set-admin.js",
    "publication:check": "node --env-file-if-exists=.env dist/scripts/preflight.js",
    "test:container": "node scripts/smoke-container.mjs"
  },
  "dependencies": {
    "@daily-co/daily-js": "^0.92.2",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "firebase": "^12.18.0",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.3.0",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/vite": "^4.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^4.3.4",
    "c8": "^12.0.0",
    "cypress": "^16.1.1",
    "esbuild": "^0.25.0",
    "firebase-tools": "^15.35.0",
    "prettier": "^3.9.9",
    "start-server-and-test": "^3.0.13",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.4.6"
  },
  "overrides": {
    "basic-ftp": "6.2.2",
    "@opentelemetry/core": "2.12.0",
    "re2": "1.27.0",
    "@grpc/grpc-js": "1.14.6",
    "firebase-tools": {
      "uuid": "11.1.1",
      "chokidar": "4.0.3"
    },
    "fast-uri": "3.1.9",
    "node-gyp": {
      "undici": "8.12.2"
    },
    "glob": {
      ".": "14.0.2",
      "minimatch": "11.0.8"
    },
    "test-exclude": {
      "glob": "14.0.2",
      "minimatch": "11.0.8"
    }
  },
  "engines": {
    "node": ">=22.23.4 <23",
    "npm": ">=10"
  }
}
